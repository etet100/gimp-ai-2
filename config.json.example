{
    "api_provider": "openai",
    "openai": {
        "api_key": "your-openai-api-key-here",
        "model": "gpt-image-2.5-flare",
        "mask_hint": true,
        "endpoint": "https://api.openai.com/v1"
    },
    "bedrock": {
        "region": "us-east-1",
        "model_id": "stability.stable-image-inpaint-v1:0",
        "erase_model_id": "stability.stable-image-erase-object-v1:0",
        "api_key": "",
        "access_key_id": "",
        "secret_access_key": "",
        "profile": "",
        "negative_prompt": "",
        "seed": 0,
        "grow_mask": 5,
        "erase_variations": 3,
        "inpaint_variations": 3,
        "generation_region": "us-west-2",
        "generation_model_id": "stability.sd3-5-large-v1:0",
        "upscale_variant": "conservative",
        "upscale_creativity": 0.35
    },
    "deepseek": {
        "api_key": "",
        "model": "deepseek-flash",
        "base_url": "https://api.deepseek.com",
        "image_model": "deepseek-flash",
        "image_base_url": "https://api.deepseek.com/v1",
        "accepts_any_size": true,
        "mask_hint": true,
        "erase_variations": 1,
        "erase_grow_mask": 8,
        "auto_enhance": false,
        "timeout": 60
    },
    "custom": {
        "base_url": "http://192.168.1.50:8080",
        "api_key": "",
        "timeout": 600,
        "extra_parameters": "{\"steps\": 20, \"cfg_scale\": 7, \"sampling_method\": \"euler\"}",
        "erase_variations": 1,
        "erase_grow_mask": 8,
        "capabilities": {
            "t2i": true,
            "inpaint": true,
            "erase": true,
            "upscale": false,
            "composite": false
        }
    },
    "prompt_enhancement": {
        "enabled": false,
        "endpoint": "http://192.168.1.50:8081/v1/chat/completions",
        "model": "local-model",
        "api_key": "",
        "timeout": 120
    },
    "settings": {
        "image_quality": 0.85,
        "max_image_size": 1024,
        "timeout": 30
    }
}
